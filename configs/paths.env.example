# Copy to configs/paths.env and `source` it before running.

# Root folder with per-benchmark annotations + images (see README §0).
export GUI_DATA_ROOT="${GUI_DATA_ROOT:-$HOME/gui_grounding_data}"

# HF-style checkpoints named as in common/models.py, e.g. Qwen3-VL-8B-Instruct
export MODELS_ROOT="${MODELS_ROOT:-$HOME/models}"

# Prefer overriding a single checkpoint (no code edit):
# export MODEL_KEY=qwen3vl_8b
# export MODEL_PATH=/path/to/Qwen3-VL-8B-Instruct

# Absolute path to vLLM CLI if not on PATH
export VLLM="${VLLM:-vllm}"

# Instruction rewrite (Exp F data prep only):
# export OPENAI_API_KEY=sk-...
# export OPENAI_BASE_URL=https://api.openai.com/v1
